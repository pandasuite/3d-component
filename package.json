{
  "name": "3d-component",
  "version": "2.4.0",
  "type": "module",
  "main": "index.js",
  "repository": "https://github.com/pandasuite/3d-component.git",
  "private": true,
  "scripts": {
    "start": "vite",
    "build": "rm -f ./pandasuite-component.zip ./3d-component-v*.zip && vite build && cd build && zip -r -X \"../3d-component-v$npm_package_version.zip\" *",
    "release": "release-it --no-npm.publish"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "release-it": "^19.2.4",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "@google/model-viewer": "^4.1.0",
    "focus-visible": "^5.2.0",
    "pandasuite-bridge": "^5.0.5",
    "three": "^0.172.0"
  },
  "release-it": {
    "hooks": {
      "after:bump": "yarn build"
    },
    "github": {
      "release": true,
      "assets": [
        "3d-component-v*.zip"
      ]
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "Chrome >= 87",
      "Android >= 5",
      "iOS >= 12"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
